generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String         @id @default(cuid())
  email             String         @unique
  senha             String
  role              Role           @default(USUARIO)
  setor             String?
  ativo             Boolean        @default(true)
  ultimaTrocaSenha  DateTime       @default(now())
  resetToken        String?        @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  matrizesCriadas   Matriz[]       @relation("Criador")
  matrizesAvaliadas Matriz[]       @relation("Avaliador")
  votos             Voto[]
  logs              Log[]
}

model Voto {
  id          String    @id @default(cuid())
  matrizId    String
  matriz      Matriz    @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  voto        TipoVoto
  comentario  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matrizId, usuarioId])
}

model Matriz {
  id                String         @id @default(cuid())
  nome              String
  oque              String
  porque            String
  como              String
  quando            String
  onde              String
  quanto            String
  impacto           Impacto        @default(MEDIO)
  observacao        String?
  percentual        Int            @default(0)
  status            Status         @default(RASCUNHO)
  comentarioComite  String?
  
  criadoPorId       String
  criadoPor         Usuario        @relation("Criador", fields: [criadoPorId], references: [id])
  avaliadoPorId     String?
  avaliadoPor       Usuario?       @relation("Avaliador", fields: [avaliadoPorId], references: [id])
  
  acoes             AcoesMatriz[]
  votos             Voto[]
  dataCriacao       DateTime       @default(now())
  dataAvaliacao     DateTime?
  updatedAt         DateTime       @updatedAt
}

model AcoesMatriz {
  id          String   @id @default(cuid())
  matrizId    String
  matriz      Matriz   @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  acaoId      String
  acao        Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  etapas      Json     @default("[]")

  @@unique([matrizId, acaoId])
}

model Acao {
  id               String         @id
  og               String?
  lae              String?
  projetoCodigo    String?
  projetoNome      String?
  projetoTema      String?
  diretriz         String
  prazo            Prazo
  setor            String?
  meta             String
  indicador        String
  restricoes       String?
  linhaPlanilha    Int
  responsavel      String?
  dadosIncompletos String[]
  
  matrizes         AcoesMatriz[]
}

model Log {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  acao        String
  detalhes    String?
  ip          String?
  createdAt   DateTime @default(now())
}

enum Role {
  USUARIO
  COMITE
  ADMIN_SETOR
  ADMIN_GERAL
}

enum TipoVoto {
  APROVAR
  REJEITAR
}

enum Status {
  RASCUNHO
  ENVIADO
  APROVADO
  PENDENTE
}

enum Impacto {
  BAIXO
  MEDIO
  ALTO
}

enum Prazo {
  CURTO_PRAZO
  MEDIO_PRAZO
  LONGO_PRAZO
}